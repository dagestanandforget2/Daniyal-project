<section id="collections" class="sec">
  <div class="sec-h"><h2>{{ section.settings.heading }}</h2></div>
  <table class="tt">
    <thead><tr><th>Collection</th><th>Size</th><th></th></tr></thead>
    <tbody>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            <tr {{ block.shopify_attributes }}><td><b>{{ c.title }}</b></td><td class="m">{{ c.products_count }} products</td><td><a class="link" href="{{ c.url }}">Browse</a></td></tr>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections -%}
          {%- unless c.handle contains 'auto-' or c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}
            <tr><td><b>{{ c.title | capitalize }}</b></td><td class="m">{{ c.products_count }} products</td><td><a class="link" href="{{ c.url }}">Browse</a></td></tr>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </tbody>
  </table>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }] }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
