<article class="sec narrow-page">
  <p class="kicker"><a href="{{ blog.url }}">{{ blog.title }}</a> · {{ article.published_at | date: '%-d %B %Y' }}</p>
  <h1 class="h2">{{ article.title }}</h1>
  <div class="prose">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
