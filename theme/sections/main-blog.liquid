{%- paginate blog.articles by 12 -%}
<section class="sec narrow-page">
  <div class="sec-h"><h1 class="h2">{{ blog.title }}</h1></div>
  <ol class="ledger">
    {%- for article in blog.articles -%}
      <li class="row plain-row"><div class="ttl"><b><a href="{{ article.url }}">{{ article.title }}</a></b><span class="sub">{{ article.published_at | date: '%-d %B %Y' }}</span></div></li>
    {%- else -%}<li class="empty">No posts yet.</li>
    {%- endfor -%}
  </ol>
  {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
