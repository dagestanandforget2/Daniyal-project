{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all-books']
  endif
-%}
<section id="catalogue" class="sec">
  <div class="sec-h">
    <h2>{{ section.settings.heading }}</h2>
    {%- if source != blank -%}<p><a class="link" href="{{ source.url }}">View all {{ source.products_count }} in {{ source.title | capitalize }}</a></p>{%- endif -%}
  </div>
  <ol class="ledger">
    {%- for product in source.products limit: section.settings.limit -%}
      {% render 'product-row', product: product %}
    {%- else -%}
      <li class="empty">Add products to this collection to see them here.</li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Product list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New and in stock" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the All Books collection." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 6, "max": 36, "step": 2, "default": 16 }
  ],
  "presets": [{ "name": "Product list" }]
}
{% endschema %}
